# Supabase Session Pooler connection string (NOT the direct db.<project>.supabase.co host)
# Format: postgresql://postgres.<project_ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxx:yourpassword@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
